# Only source scripts and documentation are tracked.
/*
!/.gitignore
!/README.md
!/simulation/
!/fhs_application/
/simulation/*
!/simulation/01_generate_data.R
!/simulation/02_run_analysis.R
!/simulation/03_make_tables_figures.R
!/simulation/helpers.R
/fhs_application/*
!/fhs_application/README.md
!/fhs_application/01_prepare_data.R
!/fhs_application/02_analysis.R
# Generated files stay local.
_local/
*.csv
*.CSV
*.rds
*.RDS
*.RData
*.rda
*.pdf
*.png
*.zip
*.gz
.Rhistory
.Rproj.user/
